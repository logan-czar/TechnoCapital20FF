{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["packages/**", "apps/**", "scripts/**", "*.json", "*.ts", "!**/dist", "!**/*.tsbuildinfo"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/sim/src/**", "packages/sim-data/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "The sim reads no wall clock: use time/calendar (spec 3.1).",
                  "performance": "The sim reads no wall clock.",
                  "window": "The sim has no DOM.",
                  "document": "The sim has no DOM."
                }
              }
            }
          },
          "suspicious": {
            "noShadowRestrictedNames": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tc20ff/sim/internal": "The UI reads only the views (spec 9): never the raw world tables."
                }
              }
            }
          }
        }
      }
    }
  ]
}
