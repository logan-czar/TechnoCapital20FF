# Shell scripts must keep LF endings even with core.autocrlf on Windows.
*.sh text eol=lf
# Map assets are regenerated by tools/map-pipeline; keep the tables LF so a rerun shows no change.
assets/map/**/*.csv text eol=lf
assets/map/*.csv text eol=lf
assets/map/*.toml text eol=lf
# A save written by an older build, loaded by the save tests (D800): bytes, never text.
*.tc20ffsave binary
# The TypeScript workspace (D950): Biome formats with LF, so keep these LF on Windows checkouts too.
# This covers the golden fixtures in packages/sim/test/fixtures, written with LF by
# docs/design/tools/mvp-data/export_fixtures.py, so a regenerated fixture does not show as changed.
packages/** text=auto eol=lf
apps/** text=auto eol=lf
scripts/ts/** text eol=lf
test/fixtures/** text eol=lf
/*.json text eol=lf
/*.ts text eol=lf
/pnpm-lock.yaml text eol=lf
/pnpm-workspace.yaml text eol=lf
# The generated 1995 world; tools/world-1995/gen.py writes LF, so a rerun shows no change.
assets/worlds/**/*.csv text eol=lf
assets/worlds/**/*.json text eol=lf
docs/build/decisions.md merge=union
