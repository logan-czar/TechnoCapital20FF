{
  "name": "@tc20ff/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The game as an Electron app: the UI of apps/web in a window, the sim in a Node utility process (pivot 15.1).",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "start": "electron .",
    "smoke": "node scripts/smoke.ts",
    "determinism": "node scripts/determinism.ts",
    "test": "vitest run",
    "e2e": "node e2e/run.ts",
    "e2e:smoke": "node e2e/run.ts --smoke",
    "drive": "node scripts/drive.ts"
  },
  "dependencies": {
    "@tc20ff/sim": "workspace:*",
    "@tc20ff/sim-data": "workspace:*",
    "@tc20ff/sim-host": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.0",
    "esbuild": "0.25.12",
    "vite": "7.1.6"
  }
}
